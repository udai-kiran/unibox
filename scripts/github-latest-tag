#!/bin/bash
# Print the tag of the latest GitHub release of OWNER/REPO.
#
# Resolves the https://github.com/OWNER/REPO/releases/latest redirect instead
# of calling api.github.com, which allows only 60 unauthenticated requests per
# hour and would otherwise make image builds fail or pick up empty versions.
set -euo pipefail

repo="${1:?usage: github-latest-tag OWNER/REPO}"
url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${repo}/releases/latest")"
tag="${url##*/releases/tag/}"

if [ -z "$tag" ] || [ "$tag" = "$url" ]; then
    echo "github-latest-tag: could not resolve latest release tag for ${repo} (got: ${url})" >&2
    exit 1
fi

printf '%s\n' "$tag"
